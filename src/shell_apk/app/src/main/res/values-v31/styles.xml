<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: brand background + the app's own icon. -->
    <style name="ApplixShellTheme" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">@drawable/applix_launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/applix_launch_bg</item>
        <item name="android:navigationBarColor">@color/applix_launch_bg</item>
        <item name="android:windowSplashScreenBackground">@color/applix_launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/applix_launch_bg</item>
    </style>
</resources>
